# ══════════════════════════════════════════════════════════════
# Healix — .env.example
# Copy to .env and fill in your values
# ══════════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── Mode ──────────────────────────────────────────
REPORT_ONLY=false

# ── Ollama (local model) ─────────────────────────
OLLAMA_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SEC=200
OLLAMA_KEEP_ALIVE=-1
OLLAMA_WARMUP_TIMEOUT_SEC=300

# ── Groq (cloud, fast) ───────────────────────────
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SEC=30

# ── Cerebras (cloud, high-throughput) ─────────────
CEREBRAS_API_KEY=your-cerebras-api-key
CEREBRAS_MODEL=qwen3-235b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_TIMEOUT_SEC=30

# ── Mistral (cloud, code-specialized) ─────────────
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=codestral-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_TIMEOUT_SEC=30

# ── OpenRouter (cloud, catch-all) ─────────────────
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=deepseek/deepseek-r1:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SEC=30

# ── Provider Chain Order ──────────────────────────
DIAGNOSIS_PROVIDER_CHAIN=groq,ollama,cerebras,gemini,mistral,openrouter

# ── Platforms ─────────────────────────────────────
ENABLE_K8S=true
ENABLE_DOCKER=true
DOCKER_HOST_LABEL=
WATCH_NAMESPACES=demo
POLL_INTERVAL_SEC=30
MAX_RESTARTS=3
DRY_RUN=false
LOG_TAIL_LINES=50

# ── Loki ──────────────────────────────────────────
LOKI_URL=http://localhost:3100
LOKI_LOOKBACK_MINUTES=30
LOKI_QUERY_LIMIT=200
LOKI_TIMEOUT_SEC=10
LOKI_DOCKER_LABEL_TEMPLATE=

# ── Prometheus ────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT_SEC=5

# ── n8n ───────────────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678/webhook/k8s-heal
N8N_TIMEOUT_SEC=5

# ── Email ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
DEV_EMAILS=dev1@example.com,dev2@example.com
OPS_EMAILS=ops@example.com

# ── Rollback ──────────────────────────────────────
HEAL_VERIFY_ENABLED=true
HEAL_VERIFY_DELAY_SEC=60

# ── Event-driven triggers ─────────────────────────
WATCH_EVENTS_ENABLED=true
WATCH_EVENTS_DEBOUNCE_SEC=300

# ── Observability ─────────────────────────────────
HEALTH_PORT=9990
METRICS_ENABLED=true
DIAGNOSIS_HISTORY_SIZE=50

# ── Cost Estimation ───────────────────────────────
COST_PER_GB_HOUR=0.0000016
COST_PER_CPU_HOUR=0.0056

# ── Dashboard Auth ────────────────────────────────
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin

# ── Approval Mode (Human-in-the-Loop) ─────────────
APPROVAL_MODE=true
APPROVAL_TIMEOUT_HOURS=24
APPROVAL_DASHBOARD_URL=http://localhost:8080

# ── Email Reply Reader (IMAP) ─────────────────────
IMAP_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_POLL_INTERVAL=30

# ── Database (PostgreSQL) ─────────────────────────
DATABASE_URL=postgresql://healer:healer@localhost:5432/healer

# ── Circuit Breaker ───────────────────────────────
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_WINDOW_MIN=60
CIRCUIT_BREAKER_COOLDOWN_MIN=1440
