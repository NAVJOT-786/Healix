{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "dr-demo-web",
    "namespace": "demo"
  },
  "spec": {
    "replicas": 1,
    "selector": {
      "matchLabels": {
        "app": "dr-demo-web"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "dr-demo-web"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "nginx",
            "image": "nginx:alpine",
            "ports": [
              {
                "containerPort": 80
              }
            ],
            "resources": {
              "requests": {
                "cpu": "10m",
                "memory": "32Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "64Mi"
              }
            }
          }
        ]
      }
    }
  }
}